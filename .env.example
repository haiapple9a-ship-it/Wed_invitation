# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Session
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_characters
COOKIE_SECURE=false

# Default Admin Credentials (initialized on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# Optional: Google Sheets Apps Script URL for server-side backup sync
GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
